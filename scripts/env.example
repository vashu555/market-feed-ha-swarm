# Settings for scripts/release.sh and scripts/status.sh.
# Copy this file to scripts/.env and fill it in. scripts/.env is ignored by git; don't share it.

# SSH program. Git Bash on Windows: the built-in Windows OpenSSH. WSL/Linux/macOS: ssh
SSH_BIN=/c/Windows/System32/OpenSSH/ssh.exe

# Mumbai VM: builds the images and runs the Swarm commands.
MUMBAI_KEY="D:/path/to/mumbai-ssh.key"
MUMBAI_HOST=ubuntu@<mumbai-public-ip>

# Hyderabad VM: receives a copy of Mumbai's images.
HYDERABAD_KEY="C:/Users/<you>/.ssh/hyderabad-ssh.key"
HYDERABAD_HOST=ubuntu@<hyderabad-public-ip>

# Micro VM: the third Swarm manager (votes only, no containers). Used by scripts/demo.
MICRO_KEY="D:/path/to/micro-ssh.key"
MICRO_HOST=opc@<micro-public-ip>

# Public addresses users open: the Cloudflare Tunnel name first, then each VM's HAProxy directly.
PUBLIC_URLS="https://market.<your-domain> http://<mumbai-public-ip>:18080 http://<hyderabad-public-ip>:18080"

# Optional, for scripts/demo (defaults shown)
# MUMBAI_NODE=instance-20260319-0225
# HYDERABAD_NODE=oci-hyderabad
# MICRO_NODE=micro-lb-2
